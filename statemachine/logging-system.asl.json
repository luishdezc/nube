{
  "StartAt": "ParseBatch",
  "States": {
    "ParseBatch": {
      "Type": "Task",
      "Resource": "${PARSE_BATCH_ARN}",
      "ResultPath": "$.parsed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ProcesarLineas"
    },
    "ProcesarLineas": {
      "Type": "Map",
      "ItemsPath": "$.parsed.lines",
      "MaxConcurrency": 5,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "ClasificarLinea",
        "States": {
          "ClasificarLinea": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.log",
                "StringMatches": "*Invalid user*",
                "Next": "GuardarAlertaUsuarioInvalido"
              },
              {
                "Variable": "$.log",
                "StringMatches": "*POSSIBLE BREAK-IN ATTEMPT*",
                "Next": "GuardarAlertaBreakIn"
              }
            ],
            "Default": "GuardarLog"
          },
          "GuardarAlertaUsuarioInvalido": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${ALERTS_TABLE}",
              "Item": {
                "pk": {
                  "S.$": "$.pk"
                },
                "sk": {
                  "S.$": "$.sk"
                },
                "alert_type": {
                  "S": "INVALID_USER"
                },
                "timestamp": {
                  "S.$": "$.timestamp"
                },
                "ts_iso": {
                  "S.$": "$.ts_iso"
                },
                "hostname": {
                  "S.$": "$.hostname"
                },
                "program": {
                  "S.$": "$.program"
                },
                "pid": {
                  "N.$": "$.pid"
                },
                "log": {
                  "S.$": "$.log"
                },
                "batch": {
                  "S.$": "$.batch"
                },
                "line": {
                  "N.$": "$.line"
                },
                "ingested_at": {
                  "S.$": "$.ingested_at"
                },
                "expires_at": {
                  "N.$": "$.expires_at"
                },
                "s3_last_modified": {
                  "S.$": "$.s3_last_modified"
                },
                "gsi_pk": {
                  "S": "ALERT"
                },
                "severity": {
                  "S": "MEDIUM"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.RequestLimitExceeded",
                  "DynamoDB.InternalServerError"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 5,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "End": true
          },
          "GuardarAlertaBreakIn": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${ALERTS_TABLE}",
              "Item": {
                "pk": {
                  "S.$": "$.pk"
                },
                "sk": {
                  "S.$": "$.sk"
                },
                "alert_type": {
                  "S": "BREAK_IN_ATTEMPT"
                },
                "timestamp": {
                  "S.$": "$.timestamp"
                },
                "ts_iso": {
                  "S.$": "$.ts_iso"
                },
                "hostname": {
                  "S.$": "$.hostname"
                },
                "program": {
                  "S.$": "$.program"
                },
                "pid": {
                  "N.$": "$.pid"
                },
                "log": {
                  "S.$": "$.log"
                },
                "batch": {
                  "S.$": "$.batch"
                },
                "line": {
                  "N.$": "$.line"
                },
                "ingested_at": {
                  "S.$": "$.ingested_at"
                },
                "expires_at": {
                  "N.$": "$.expires_at"
                },
                "s3_last_modified": {
                  "S.$": "$.s3_last_modified"
                },
                "gsi_pk": {
                  "S": "ALERT"
                },
                "severity": {
                  "S": "HIGH"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.RequestLimitExceeded",
                  "DynamoDB.InternalServerError"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 5,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "End": true
          },
          "GuardarLog": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${LOGS_TABLE}",
              "Item": {
                "pk": {
                  "S.$": "$.pk"
                },
                "sk": {
                  "S.$": "$.sk"
                },
                "timestamp": {
                  "S.$": "$.timestamp"
                },
                "ts_iso": {
                  "S.$": "$.ts_iso"
                },
                "hostname": {
                  "S.$": "$.hostname"
                },
                "program": {
                  "S.$": "$.program"
                },
                "pid": {
                  "N.$": "$.pid"
                },
                "log": {
                  "S.$": "$.log"
                },
                "batch": {
                  "S.$": "$.batch"
                },
                "line": {
                  "N.$": "$.line"
                },
                "ingested_at": {
                  "S.$": "$.ingested_at"
                },
                "expires_at": {
                  "N.$": "$.expires_at"
                },
                "s3_last_modified": {
                  "S.$": "$.s3_last_modified"
                },
                "gsi_pk": {
                  "S": "LOG"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.RequestLimitExceeded",
                  "DynamoDB.InternalServerError"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 5,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "End": true
    }
  }
}
